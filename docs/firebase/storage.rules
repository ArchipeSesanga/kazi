rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function isImageUnder(mb) {
      return request.resource.contentType != null
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size < mb * 1024 * 1024;
    }

    match /media/{userId}/{allPaths=**} {
      allow read: if true;
    }

    match /media/{userId}/{kind}/{fileName} {
      allow create, update: if isOwner(userId)
        && kind in ['avatar', 'cover', 'portfolio']
        && isImageUnder(2);
      allow delete: if isOwner(userId);
    }

    match /media/{userId}/listings/{listingId}/{fileName} {
      allow create, update: if isOwner(userId) && isImageUnder(2);
      allow delete: if isOwner(userId);
    }

    match /private/verification/{userId}/{fileName} {
      allow create: if isOwner(userId) && isImageUnder(5);
      allow read, update, delete: if false;
    }
  }
}