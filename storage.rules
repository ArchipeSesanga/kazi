rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Verified phone number (the account identity) or a staff claim; an
    // email-only account is treated like a guest (mirrors firestore.rules).
    function signedIn() {
      return request.auth != null
        && ('phone_number' in request.auth.token
            || request.auth.token.get('admin', false) == true
            || request.auth.token.get('moderator', false) == true);
    }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function isImageUnder(mb) {
      return request.resource.contentType != null
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size < mb * 1024 * 1024;
    }

    // Sign-in only. Download URLs carry their own token, so images still load
    // in the app; this limits SDK reads and listing.
    match /media/{userId}/{allPaths=**} {
      allow read: if signedIn();
    }

    match /media/{userId}/{kind}/{fileName} {
      allow create, update: if isOwner(userId)
        && kind in ['avatar', 'cover', 'portfolio']
        && isImageUnder(2);
      allow delete: if isOwner(userId);
    }

    match /media/{userId}/listings/{listingId}/{fileName} {
      allow create, update: if isOwner(userId) && isImageUnder(2);
      allow delete: if isOwner(userId);
    }

    match /private/verification/{userId}/{fileName} {
      // Write-once: `resource == null` also blocks overwrites that the
      // emulator would otherwise classify as a create.
      allow create: if isOwner(userId) && resource == null && isImageUnder(5);
      allow read, update, delete: if false;
    }
  }
}